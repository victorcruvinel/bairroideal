{
  // Bairro Ideal · criador de maquetes de bairros. Publicado pelo Cloudflare Workers a cada push na main.
  "name": "bairroideal",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // o que não é arquivo da pasta public (/api, /sw.js, /versao.json) cai no worker
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // mantém as variáveis criadas no painel do Cloudflare (APPS_SCRIPT_URL e o segredo BAIRRO_TOKEN)
  "keep_vars": true,
  "routes": [{ "pattern": "bairroideal.victorcruvinel.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
